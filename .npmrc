# `workspace:^` references inside a transitive lockfile entry trip up
# npm 10+ with EUNSUPPORTEDPROTOCOL. Vercel runs plain `npm install`
# without flags by default, which is why builds started failing after
# the @tsparticles deps landed (one of their sub-deps still ships a
# `workspace:^` marker from a monorepo build).
#
# legacy-peer-deps relaxes the resolution so the install completes
# without rewriting the lockfile by hand.
legacy-peer-deps=true
